# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional, off by default. Set to "true" to cache generated quizzes by
# book+chapter (in-memory, per process — see lib/quiz-cache.ts) so repeat
# requests for the same one skip the Anthropic call. Mainly useful if this
# is ever deployed somewhere with real traffic; leave unset for local use.
# ENABLE_QUIZ_CACHE=true
